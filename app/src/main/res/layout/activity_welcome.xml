<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/heroImage2"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:scaleType="centerCrop"
            android:src="@drawable/trees" />

        <TextView
            android:id="@+id/headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Join Us in Protecting Our Planet"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#131613"
            android:gravity="center"
            android:layout_marginTop="24dp" />

        <!-- Description -->
        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Discover how you can make a difference with our app. Track your impact, get eco-friendly tips, and join community challenges."
            android:textSize="14sp"
            android:textColor="#131613"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSignUp_welcome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sign Up"
            android:textColor="#131613"
            android:textStyle="bold"
            android:backgroundTint="#b8e4b8" />

        <Button
            android:id="@+id/btnSignin_welcome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Sign In"
            android:textColor="#131613"
            android:textStyle="bold"
            android:backgroundTint="#E2E7E2"
            android:layout_marginTop="12dp" />


        <TextView
            android:id="@+id/featuresTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Key Features"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#131613"
            android:layout_marginTop="24dp" />

        <!-- Features Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true"
            android:layout_marginTop="12dp">

            <!-- Feature Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/feature_card_grid"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_leaf"
                    app:tint="#1B5E20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Track Your\nImpact"
                    android:textColor="#131613"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Feature Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/feature_card_grid"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_tree"
                    app:tint="#1B5E20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Eco-Friendly\nTips"
                    android:textColor="#131613"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Feature Card -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/feature_card_grid"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_users"
                    app:tint="#1B5E20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Community\n For Sharing"
                    android:textColor="#131613"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_margin="6dp"
                android:background="@drawable/feature_card_grid"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_predict"
                    app:tint="#1B5E20" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Predict New\n Impact"
                    android:textColor="#131613"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </GridLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/footerNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2024 EcoApp. All rights reserved."
            android:textColor="#6b806b"
            android:textSize="14sp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center" />
    </LinearLayout>
</ScrollView>
