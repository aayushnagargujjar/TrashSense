<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#F9FAFB"
    android:fillViewport="true"
    tools:context=".AI_Eco_Dashboard.Co2Estimation.Instedof_Transport">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SELECT TRANSPORT"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#111827"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/textView6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select the transport you intended to use, but opted for a greener choice!"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="32dp" />

        <!-- Grid Layout with 6 options -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="true">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:id="@+id/InsteadT_walk"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/walk"
                    android:contentDescription="Walk" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walk"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Repeat for Cycle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:id="@+id/InsteadT_cycle"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/cycle"
                    android:contentDescription="Cycle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cycle"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Train -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:id="@+id/InsteadT_train"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_train"
                    android:contentDescription="Train" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Train"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Bus -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:id="@+id/InsteadT_bus"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_bus"
                    android:contentDescription="Bus" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bus"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Motorbike -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:id="@+id/InsteadT_motorbike"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_motarbike"
                    android:contentDescription="Motorbike" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motorbike"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Car -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:id="@+id/InsteadT_car"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/rounded_card_bg"
                android:padding="20dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_car"
                    android:contentDescription="Car" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Car"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#1F2937"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </GridLayout>
    </LinearLayout>
</ScrollView>
