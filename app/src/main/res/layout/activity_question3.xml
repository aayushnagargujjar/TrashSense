<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What are your sustainability goals?"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#222222"
            android:paddingBottom="16dp" />

        <CheckBox
            android:id="@+id/goalPlastic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reduce plastic 🚯"
            android:textSize="18sp"
            android:paddingVertical="8dp" />

        <CheckBox
            android:id="@+id/goalEnergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save energy 🔋"
            android:textSize="18sp"
            android:paddingVertical="8dp" />

        <CheckBox
            android:id="@+id/goalCarbon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lower carbon emissions 🛻"
            android:textSize="18sp"
            android:paddingVertical="8dp" />

        <Button
            android:id="@+id/btnShowResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Recommendations ✅"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:layout_marginTop="32dp"
            android:backgroundTint="@color/teal_700"
            android:textColor="@android:color/white"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
